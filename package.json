{
  "name": "delgender-research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Finds Johannesburg companies that could use help with PR, social media or their website, and sends them to the Delgender staff portal for review.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "agent": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
